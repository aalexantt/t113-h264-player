#!/bin/sh /etc/rc.common
# gopanel - BingPi-M2 单文件 Web 管理面板，开机自启
#
# 挂载点说明/重要：这个脚本必须命名为 /etc/init.d/S97gopanel。
# 本构建的 rc.final 遍历的是 /etc/init.d/S??*，不是 /etc/rc.d/。
#
# START=97 让它排在 S96wifi-auto 之后 —— 面板要显示 WiFi 状态，
# 得等网络先起来。

START=97
STOP=16

BIN=/opt/gopanel/gopanel
DATADIR=/opt/gopanel/data
PIDFILE=/var/run/gopanel.pid
# 端口用 80，这样局域网直接 http://linuxhost.local/ 就能访问，不用带端口号。
# gopanel 以 root 运行，绑定特权端口没问题。
# 如果 80 被其他服务占了，改回 8080 即可（地址变成 http://linuxhost.local:8080/）。
PORT=80

# ---------------------------------------------------------------------------
# 为什么需要 OOM 保护
# ---------------------------------------------------------------------------
# 这块板子 MemTotal 只有 108MB，长期运行会频繁触发 OOM killer。
#
# gopanel 是 Go 程序，启动时会预留很大的虚拟地址空间（实测 total-vm 572MB），
# 而实际 RSS 只有 3.6MB。但内核的 OOM 评分主要看 total-vm 和 RSS 的综合，
# 结果它成了 oom_score 最高的进程，每次内存紧张都被优先杀掉。
#
# 实测记录（dmesg）：
#   [38649] adbd invoked oom-killer
#   [38650] oom-kill: task=gopanel, pid=202
#   Out of memory: Killed process 202 (gopanel) total-vm:572192kB anon-rss:1892kB
#
# 注意触发者是 adbd —— 也就是调试时的 adb 命令（pull 大文件等）把内存压垮了。
#
# 处理办法：把 oom_score_adj 调到 -500，显著降低被杀概率。
# 取值范围 -1000 ~ 1000，-1000 表示完全豁免（不推荐，真正缺内存时会更糟）。
OOM_ADJ=-500

# ---------------------------------------------------------------------------
# mDNS —— 让局域网用 http://linuxhost.local:8080/ 访问
# ---------------------------------------------------------------------------
# gopanel 自带 mDNS 广播，但默认关闭，必须显式传 -mdns 才启用。
# -host 指定广播的主机名，不传的话取系统 hostname（本机是 TinaLinux），
# 那样广播出去就是 TinaLinux.local，不是我们要的 linuxhost.local。
#
# 注意：
#   1. mDNS 走多播，不需要 DNS 服务器，Windows 10/11、macOS、Linux(avahi)
#      都原生支持 .local 解析。nslookup 查不到是正常的——它只问 DNS 服务器，
#      不走多播。要用 ping 或浏览器测。
#   2. 端口设成 80，所以局域网直接访问 http://linuxhost.local/ 即可，
#      不用带端口号。见上面的 PORT 说明。
MDNS_ENABLE=1
MDNS_HOST=linuxhost

start() {
    [ -x "$BIN" ] || {
        logger -t gopanel "binary not found: $BIN"
        return 1
    }

    pidof gopanel >/dev/null 2>&1 && return 0

    mkdir -p "$DATADIR"

    # 组装启动参数。
    #
    # 【不能用 set --】set -- 会覆盖脚本自身的位置参数 $1/$2...，
    # 而 rc.common 是靠 $1（start/stop/restart）来决定调用哪个函数的。
    # 【注意冒号】gopanel 的 -addr 要的是 Go 的 "host:port" 格式，
# 只监听所有地址时必须写成 ":80"（前面带冒号）。
# 写成 "80" 会报 `listen tcp: address 80: missing port in address`。
ar_args="-addr :$PORT -data $DATADIR"

    if [ "$MDNS_ENABLE" = "1" ]; then
        ar_args="$ar_args -mdns -host $MDNS_HOST"
    fi

    # 【关于 start-stop-daemon -b】
    #
    # rc.common 最后一行是 `"$action" "$@" &`，已经把 start() 放到后台了。
    # 叠加 -b 理论上会多一层后台，但实测 -b 反而更可靠：
    # 不加 -b 时 start-stop-daemon 是前台等待模式，配合 rc.common 的 &
    # 会出现 pidfile 和实际进程对不上的情况。
    #
    # 实测：
    #   -b + 正确参数  → 进程存活，pidfile 正确
    #   -b + 错误参数  → start-stop-daemon 仍返回 0 并写 pidfile，但进程立刻退出，
    #                    pidof 找不到，且没有任何报错（这是排查中最耗时的坑）
    # 所以 start() 末尾必须用 pidof 二次确认，不能只看 start-stop-daemon 的返回值。
    # shellcheck disable=SC2086  # 这里就是要按空格拆成多个参数
    start-stop-daemon -S -b -x "$BIN" -m -p "$PIDFILE" -- $ar_args

    sleep 2

    if pidof gopanel >/dev/null 2>&1; then
        pid=$(pidof gopanel)
        # 降低被 OOM 杀掉的概率。写失败不影响启动，只是没这层保护。
        echo $OOM_ADJ > /proc/$pid/oom_score_adj 2>/dev/null
        logger -t gopanel "started on port $PORT (pid $pid, oom_adj $OOM_ADJ)"
    else
        logger -t gopanel "FAILED to start"
        return 1
    fi
}

stop() {
    # 先杀 watchdog，否则它会在我们杀完 gopanel 后立刻又拉起来
    [ -x /etc/init.d/S98gopanel-watchdog ] && \
        /etc/init.d/S98gopanel-watchdog stop 2>/dev/null

    pidof gopanel >/dev/null 2>&1 || return 0

    # start-stop-daemon -K 的 -x 要指向实际的可执行文件路径，
    # 之前用的 $BIN 没问题，但进程可能是被 start-stop-daemon -b 起的，
    # pidfile 不一定可靠，所以 killall 兜底。
    start-stop-daemon -K -p "$PIDFILE" 2>/dev/null
    sleep 1
    killall gopanel 2>/dev/null
    sleep 1
    killall -9 gopanel 2>/dev/null

    rm -f "$PIDFILE"
    logger -t gopanel "stopped"
}

# 供 watchdog 调用：只检查并在挂了时重启，不做别的
ensure() {
    if pidof gopanel >/dev/null 2>&1; then
        return 0
    fi
    logger -t gopanel "not running, restarting"
    start
}