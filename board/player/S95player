#!/bin/sh /etc/rc.common
# S95player — 开机自动循环播放视频
#
# 启动顺序说明：
#   START=95 排在 S96wifi-auto 之前。播放不需要网络，早点起来能更快出画面。
#   也不能太早——要等 /dev/disp 和 /dev/cedar_dev 就绪，那是 rcS 早期就初始化好的。
#
# 为什么放在单独脚本而不是塞进 S97gopanel：
#   两者互不相关。播放挂了不该影响 Web 面板，反之亦然。
#   独立脚本便于单独 start/stop 排查。

START=95
STOP=20

BIN=/opt/player
# 默认播放无音轨的版本。
# 带音轨的 1280x720.mp4 也能用，但播放器目前还没接 AAC 解码，
# 用带音轨的文件只是多解析一个用不上的 trak，不如直接用 noaudio 版省事。
# 想换文件改这一行即可。
MEDIA=${MEDIA:-/opt/media/1080p30.mp4}
PIDFILE=/var/run/player.pid
LOGFILE=/tmp/player.log

# 播放器进程的 oom_score_adj。
# 理由同 gopanel：板子内存只有 108MB，播放器开了硬解缓冲后占用不小，
# 内存紧张时容易被 OOM 杀掉。设 -300 比 gopanel 的 -500 保守一些，
# 因为 Web 面板的可用性优先级更高。
OOM_ADJ=-300

start() {
    [ -x "$BIN" ] || {
        logger -t player "binary not found: $BIN"
        return 1
    }

    pidof player >/dev/null 2>&1 && return 0

    [ -f "$MEDIA" ] || {
        logger -t player "media not found: $MEDIA"
        return 1
    }

    # 启动播放器。
    #
    # 【必须用 start-stop-daemon -b，不能改成 setsid ... & 或 nohup】
    # 试过改成 `setsid "$BIN" ... &` 想让日志落到文件，结果这块板子的
    # busybox 根本没有 setsid，退化到普通后台运行 —— 脚本一退出，
    # 子进程立刻收到 SIGHUP 被杀掉。现象是：start 当场能看到进程、
    # 几秒后就没了，日志停在初始化阶段（连"开始播放"都没打印）。
    #
    # start-stop-daemon -b 自己会做 daemon 化（setsid + 关闭继承的 fd），
    # 进程能活下来。代价是它把 stdout/stderr 全部指向 /dev/null。
    #
    # 日志问题的正解：让播放器自己写日志文件（见 player.c 的
    # log_file_init()，把 stdout 重定向到 /tmp/player.log），
    # 而不是依赖 shell 的重定向。这样 -b 丢不丢输出都无所谓。
    start-stop-daemon -S -b -x "$BIN" -m -p "$PIDFILE" -- "$MEDIA" --loop

    sleep 2

    # 注：开机 LOGO 残留的清理已经移到播放器内部
    # （player.c 的 fb_clear_alpha()，在 disp 初始化之后调用）。
    # 放播放器里的好处是：手动跑 ./player 也能清，不依赖这个脚本；
    # 而且清完立刻就有视频帧盖上来，中间没有黑屏空窗。

    if pidof player >/dev/null 2>&1; then
        pid=$(pidof player)
        echo $OOM_ADJ > /proc/$pid/oom_score_adj 2>/dev/null
        logger -t player "started (pid $pid, media $MEDIA, oom_adj $OOM_ADJ)"
    else
        logger -t player "FAILED to start, see $LOGFILE"
        return 1
    fi
}

stop() {
    # 注意：不能写 `pidof player || return 0`。
    # 那样进程本来就没跑时不会走到下面的 rm -f "$PIDFILE"，
    # pidfile 会残留，下次 start 时 start-stop-daemon 可能误判。
    if pidof player >/dev/null 2>&1; then
        # 先 TERM 让它自己清理 disp 层和解码器
        pid=$(pidof player)
        [ -n "$pid" ] && kill -TERM $pid 2>/dev/null

        # 给 3 秒优雅退出时间（要还帧、关解码器、清 disp）
        i=0
        while [ $i -lt 6 ]; do
            pidof player >/dev/null 2>&1 || break
            sleep 0.5
            i=$((i+1))
        done

        # 还不走就强杀。
        # 强杀后播放器来不及关 disp 层，但下次启动时会重新配置同一组层
        # （ch0/lyr0、ch1/lyr1），覆盖掉旧状态，不需要额外清理。
        if pidof player >/dev/null 2>&1; then
            logger -t player "graceful stop timeout, force killing"
            killall -9 player 2>/dev/null
            sleep 1
        fi
    fi

    rm -f "$PIDFILE"
    logger -t player "stopped"
}

restart() {
    stop
    sleep 1
    start
}